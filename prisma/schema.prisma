generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  role           UserRole        @default(ADMIN)
  isActive       Boolean         @default(true)
  avatar         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  auditLogs      AuditLog[]
  otpCodes       OTPCode[]
  stockMovements StockMovement[]

  @@index([email])
  @@map("users")
}

model OTPCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expires   DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [email], references: [email])

  @@index([email])
  @@index([code])
  @@map("otp_codes")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  emoji       String?
  color       String?
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@map("categories")
}

model Product {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  description     String?             @db.LongText
  sku             String              @unique
  categoryId      String
  stock           Int                 @default(0)
  minOrderQty     Int                 @default(1)
  basePrice       Decimal             @db.Decimal(12, 2)
  featured        Boolean             @default(false)
  status          ProductStatus       @default(DRAFT)
  viewCount       Int                 @default(0)
  engagementScore Decimal             @default(0.00) @db.Decimal(10, 2)
  trendingScore   Decimal             @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  orderItems      OrderItem[]
  pricingTiers    PricingTier[]
  engagements     ProductEngagement[]
  images          ProductImage[]
  productViews    ProductView[]
  category        Category            @relation(fields: [categoryId], references: [id])
  stockMovements  StockMovement[]

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([trendingScore])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model PricingTier {
  id        String   @id @default(cuid())
  productId String
  label     String
  minQty    Int
  maxQty    Int?
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("pricing_tiers")
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String
  country     String   @default("Rwanda")
  city        String
  address     String   @db.Text
  totalOrders Int      @default(0)
  totalSpent  Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerId      String
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  deliveryFee     Decimal     @default(0.00) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  deliveryAddress String      @db.Text
  city            String
  country         String
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  paymentMethod   String?
  items           OrderItem[]
  customer        Customer    @relation(fields: [customerId], references: [id])

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productSku  String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  sessionId String?
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([viewedAt])
  @@map("product_views")
}

model ProductEngagement {
  id        String         @id @default(cuid())
  productId String
  type      EngagementType
  sessionId String?
  createdAt DateTime       @default(now())
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("product_engagements")
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  type          StockMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  notes         String?           @db.Text
  createdById   String?
  createdAt     DateTime          @default(now())
  createdBy     User?             @relation(fields: [createdById], references: [id])
  product       Product           @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@index([createdById], map: "stock_movements_createdById_fkey")
  @@map("stock_movements")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  read      Boolean          @default(false)
  link      String?
  metadata  String?          @db.LongText
  createdAt DateTime         @default(now())

  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    String?  @db.LongText
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.LongText
  label     String
  type      String   @default("text")
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("site_settings")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("page_views")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum ProductStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  RETURN
  ADJUSTMENT
}

enum EngagementType {
  VIEW
  ADD_TO_CART
  PURCHASE
}

enum NotificationType {
  ORDER
  STOCK
  SYSTEM
  TEAM
}

model PaymentTransaction {
  id                   String        @id @default(cuid())
  requestTransactionId String        @unique
  intouchTransactionId String?
  type                 PaymentTxType
  amount               Decimal       @db.Decimal(12, 2)
  phone                String
  status               String        @default("Pending")
  responsecode         String?
  referenceNo          String?
  orderId              String?
  description          String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([requestTransactionId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("payment_transactions")
}

enum PaymentTxType {
  INCOMING
  OUTGOING
}
